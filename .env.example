# Configurações do Backend e Chatbot EmpreendaFácil
PORT=3000

# Provedor de IA: Google Gemini (Grátis em https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Provedor de IA alternativo: Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# URL da API no Front-end (caso utilize rota externa)
VITE_CHATBOT_API_URL=http://localhost:3000/api/chatbot/message
